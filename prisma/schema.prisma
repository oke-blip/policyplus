// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider  = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  value_id  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum PostType {
  INSIGHT
  KNOWLEDGE
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum JobPostingStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum JobApplicationStatus {
  PENDING
  REVIEWED
  REJECTED
  HIRED
}

model Post {
  id              String     @id @default(cuid())
  title           String
  title_id        String?
  slug            String     @unique
  content         String     @db.Text
  content_id      String?    @db.Text
  image_url       String?
  author_name     String?
  author_name_id  String?
  author_role     String?
  author_role_id  String?
  author_bio      String?    @db.Text
  author_bio_id   String?    @db.Text
  author_image    String?
  tags            String?
  tags_id         String?
  status          PostStatus @default(DRAFT)
  type            PostType   @default(INSIGHT)
  category        String?
  category_id     String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model KnowledgeCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  name_id   String?
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JobPosting {
  id               String           @id @default(cuid())
  title            String
  title_id         String?
  department       String?
  department_id    String?
  location         String?
  location_id      String?
  type             JobType          @default(FULL_TIME)
  salaryRange      String?
  salaryRange_id   String?
  description      String           @db.Text
  description_id   String?          @db.Text
  requirements     String?          @db.Text
  requirements_id  String?          @db.Text
  status           JobPostingStatus @default(DRAFT)
  applicationDeadline DateTime?
  applications     JobApplication[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model JobApplication {
  id           String               @id @default(cuid())
  jobPostingId String?
  jobPosting   JobPosting?          @relation(fields: [jobPostingId], references: [id], onDelete: SetNull)
  fullName     String
  email        String
  phone        String?
  linkedinUrl  String?
  coverLetter  String?              @db.Text
  cvFileUrl    String
  status       JobApplicationStatus @default(PENDING)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([jobPostingId])
}

model EventCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  name_id   String?
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id          String   @id @default(cuid())
  title       String
  title_id    String?
  date        String
  location    String
  location_id String?
  image       String   @db.Text
  category    String?
  category_id String?
  link        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
